{
  "name": "Open Source Design",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "postCreateCommand": "HUGO_VERSION=0.166.0 && curl -fsSL -o /tmp/hugo.deb https://github.com/gohugoio/hugo/releases/download/v${HUGO_VERSION}/hugo_extended_${HUGO_VERSION}_linux-amd64.deb && sudo dpkg -i /tmp/hugo.deb && rm /tmp/hugo.deb",
  "postStartCommand": "nohup hugo server --bind 0.0.0.0 --buildDrafts --buildFuture >/tmp/hugo.log 2>&1 &",
  "forwardPorts": [1313],
  "portsAttributes": {
    "1313": {
      "label": "Hugo preview",
      "onAutoForward": "openBrowser"
    }
  }
}
