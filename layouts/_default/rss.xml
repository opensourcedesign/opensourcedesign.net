{{- $pctx := . -}}
{{- if .IsHome -}}{{ $pctx = .Site }}{{- end -}}
{{- $pages := slice -}}
{{- if and $.IsSection (eq $.Section "jobs") -}}
{{- /* Only actual postings: the form, archive and guide pages also live in
       content/jobs/ but carry no status. */ -}}
{{- $pages = (where $pctx.RegularPages "Params.status" "!=" nil).ByDate.Reverse -}}
{{- else if or $.IsHome $.IsSection -}}
{{- $pages = $pctx.RegularPages -}}
{{- else -}}
{{- $pages = $pctx.Pages -}}
{{- end -}}
{{- $limit := .Site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}
{{- $pages = $pages | first $limit -}}
{{- end -}}
{{- partial "rss-channel.xml" (dict "page" . "pages" $pages "self" (printf "%sfeed.xml" .Permalink)) -}}
